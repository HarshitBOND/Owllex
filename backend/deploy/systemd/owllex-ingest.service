# Owllex corpus ingest worker -- drains /data/inbox into the RAG stack.
#
#   sudo systemctl enable --now owllex-ingest
#   cp -r /path/to/judgments/. /data/inbox/sci/     # then watch it drain
#   journalctl -u owllex-ingest -f
#
# Stop this unit before a migration or an index rebuild: it and the rebuild
# script both write FAISS, and only one writer at a time is safe.

[Unit]
Description=Owllex corpus ingest worker
Documentation=file:///opt/owllex/backend/deploy/README.md
After=network-online.target owllex-rag.service
Wants=network-online.target
# deploy.sh renders this from HDD_DATA_ROOT and SSD_DATA_ROOT as they actually
# appear in .env, not from a literal /data -- see the longer comment on the
# same line in owllex-rag.service (PRODUCTION_TODO.md T4b).
RequiresMountsFor=/data

[Service]
Type=exec
User=owllex
Group=owllex
WorkingDirectory=/opt/owllex/backend
EnvironmentFile=/opt/owllex/backend/.env
# On the HDD tier, not the boot SSD or the SSD tier -- see owllex-rag.service.
Environment=HF_HOME=/data/models
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# PRODUCTION_TODO.md T17: this worker is the sole FAISS writer (T2), and FAISS
# cannot mutate a memory-mapped index in place -- so this must be false
# regardless of what FAISS_MMAP is set to in the shared .env for the reading
# side (owllex-rag.service). An `Environment=` line here overrides the
# EnvironmentFile= above for this unit only, the same pattern HF_HOME already
# uses on this line, so turning mmap on for the API by editing one shared .env
# can never silently also turn it on for the writer.
Environment=FAISS_MMAP=false

ExecStart=/opt/owllex/backend/.venv/bin/python -m rag.scripts.ingest_worker

# ── Nice'd below the API on purpose ─────────────────────────────────────────
# Ingestion is throughput work with no user waiting on it; a search request is
# latency work with one waiting on every millisecond. Giving the worker a lower
# CPU and I/O priority means a bulk import runs at full speed on an idle box and
# gets out of the way the moment someone runs a query, without any coordination
# between the two processes.
Nice=10
IOSchedulingClass=idle
CPUWeight=50

Restart=always
RestartSec=30
# The worker loads the same embedding model as the API, and holds its own
# separate copy of the FAISS index in memory too (see MemoryMax below).
TimeoutStartSec=900
# Long enough for the current document to finish and FAISS to flush. A worker
# killed mid-document is safe -- LMDB is written last, so the document is simply
# re-ingested -- but a clean stop saves the next start a rebuild.
TimeoutStopSec=300
KillSignal=SIGTERM

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/data /var/log/owllex

# Same floor as owllex-rag.service and for the same reason: the FAISS index
# resident in this process's own memory (~18.4GB at tier 1 with the Flat
# factory) dominates over the embedding model (~1.2GB for
# EMBED_MODEL=qwen3-embedding-0.6b), not the other way around. Docling's own
# parsing models add to this too -- this is the process that actually does the
# OCR and layout analysis, not owllex-rag. See owllex-rag.service's MemoryMax
# comment for the full derivation and PRODUCTION_TODO.md T4b/T9.
MemoryMax=28G
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=owllex-ingest

[Install]
WantedBy=multi-user.target
