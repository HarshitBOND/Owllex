# Owllex nightly backup -- FAISS + SQLite + LMDB + an incremental document mirror.
#
# Triggered by owllex-backup.timer. Run one by hand with:
#   sudo systemctl start owllex-backup
#   journalctl -u owllex-backup -f     (also /var/log/owllex/backup.log)
#
# IMPORTANT: set BACKUP_ENABLED=false in .env when this timer is enabled.
# The API process has its own APScheduler backup job, and running both means two
# processes writing the same snapshot directory at the same time. deploy.sh sets
# this for you; the timer is the better of the two because it still runs when the
# API is down, which is exactly when you most want a backup to have happened.

[Unit]
Description=Owllex backup (FAISS, SQLite, LMDB, documents)
Documentation=file:///opt/owllex/backend/deploy/README.md
RequiresMountsFor=/data
# Ordered after the API so a boot-time catch-up run does not compete with
# startup for the disk. Not a hard dependency: a backup must still run on a box
# where the API is failing to start.
After=owllex-rag.service

[Service]
Type=oneshot
User=owllex
Group=owllex
WorkingDirectory=/opt/owllex/backend
EnvironmentFile=/opt/owllex/backend/.env
Environment=HF_HOME=/data/models
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/owllex/backend/.venv/bin/python -m rag.scripts.backup_now

# Backups are pure background I/O. Idle priority keeps a multi-hour document
# mirror from adding latency to live queries.
Nice=15
IOSchedulingClass=idle

# No Restart= : this is a oneshot under a timer. A failed run is reported by
# `systemctl status owllex-backup` and retried at the next scheduled time, which
# is better than a retry loop hammering a disk that is probably full.
# The first run copies the whole archive and can legitimately take hours;
# subsequent runs only move the day's new documents.
TimeoutStartSec=21600

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/data /var/log/owllex

StandardOutput=journal
StandardError=journal
SyslogIdentifier=owllex-backup

[Install]
WantedBy=multi-user.target
