# Byte-compiled
__pycache__/
*.py[cod]
*$py.class

# Env
.env
.venv/
env/
venv/
.env*
# The committed template. `.env*` above is deliberately broad, so the one file
# that must be in the repo is re-included here.
!.env.example

# Uploads
uploads/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test artifacts
*.txt

# Scraper session files these hold live session cookies copied from a
# browser. They are credentials: never commit them.
rag/scrapping/**/sessions/
*.curl.txt
*.cookies.json

# Scraped corpus large, and re-fetchable from the source sites.
# Both patterns are needed: a pattern containing a slash is anchored to this
# file's directory, so `data/raw/` alone matches only `backend/data/raw/` and
# silently misses the scrapers' actual output tree under `rag/scrapping/`.
data/raw/
rag/scrapping/data/

# Legacy ingest artefacts. The stack now keeps all state under DATA_ROOT
# (/data on the VPS), outside the code tree entirely -- this pattern only
# covers leftovers from before that move.
rag/data/

# A DATA_ROOT pointed inside the checkout, which is what a developer machine
# without a mounted volume ends up doing. Never commit corpus state.
/data/
data/faiss/
data/sqlite/
data/lmdb/
data/backups/
data/documents/
data/private/
