# ═══════════════════════════════════════════════════════════════════════════
# Ravenslaw backend configuration
#
# Copy to .env and fill in. Only DATA_ROOT, RAVENSLAW_INTERNAL_TOKEN,
# RAVENSLAW_CORS_ORIGINS and RAVENSLAW_TRUSTED_HOSTS are required in
# production; everything else has a working default.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────────
RAVENSLAW_HOST=0.0.0.0
RAVENSLAW_PORT=8000
RAVENSLAW_DEBUG=false

# ─── Storage layout: two tiers ─────────────────────────────────────────────
# Bulk immutable data goes on cheap spinning disk; the latency-critical
# metadata stores go on NVMe. A metadata lookup sits inside every single
# search, so on an HDD those random reads are what a query would spend most of
# its time on -- while the PDFs and the FAISS file are enormous, immutable and
# read sequentially. Paying SSD prices per GB for those is the single largest
# avoidable cost in this system.
#
#   SSD_DATA_ROOT   sqlite/, lmdb/, logs/
#   HDD_DATA_ROOT   legal_corpus/, users/, faiss/, archive/, backups/, inbox/
#
# Both default to DATA_ROOT, so leaving them unset keeps a single-volume host
# working exactly as it did. Startup refuses to run if a bulk path resolves
# onto the SSD -- filling the NVMe takes SQLite, and therefore search, down.
# Move an existing deployment with:
#   python -m rag.scripts.migrate_storage_split --plan
SSD_DATA_ROOT=/srv/owllex/ssd
HDD_DATA_ROOT=/mnt/hdd/owllex

# Legacy single-volume root. Only used for paths the two tiers above do not
# already resolve. Must be a mounted volume, never the VPS system disk.
DATA_ROOT=/data
# Public legal corpus: judgments, orders and bare acts, laid out by court and
# year. Served to any authenticated user. (Was PDF_ROOT=/data/documents, which is
# still read as an alias so an existing deployment keeps working; rename the
# directory and set this when convenient.)
LEGAL_CORPUS_ROOT=/mnt/hdd/owllex/legal_corpus
# Private per-user documents: /data/users/<user id>/<category>/<document id>.pdf.
# Served only to the owner, and only through an authenticated backend route.
# Created 0700 and re-tightened on every boot -- see rag/core/config.py.
USERS_ROOT=/mnt/hdd/owllex/users
# Read once at boot into RAM and rewritten in bulk -- entirely sequential, so
# the HDD costs nothing that matters here.
FAISS_ROOT=/mnt/hdd/owllex/faiss
# SSD tier: thousands of small random reads per query.
SQLITE_PATH=/srv/owllex/ssd/sqlite/chunks.db
LMDB_PATH=/srv/owllex/ssd/lmdb/hashdb
BACKUP_ROOT=/mnt/hdd/owllex/backups
# Caller-keyed objects written by /documents/compress and PUT /objects/<key>
# (attachments, contract reviews, template sources). Also 0700.
PRIVATE_ROOT=/mnt/hdd/owllex/private
# Drop directory drained by owllex-ingest.service. Copy PDFs in (optionally
# under a court-named subdirectory, e.g. /data/inbox/sci/) and the worker
# ingests and removes them. Failures land in /data/inbox/.failed/.
INBOX_ROOT=/mnt/hdd/owllex/inbox
# Cold storage for immutable originals -- superseded snapshots, bulk import
# tarballs. Nothing reads it on the request path.
ARCHIVE_ROOT=/mnt/hdd/owllex/archive

# ─── Application and log roots (system SSD, NOT the data volume) ───────────
# These are the two paths that deliberately do not live under DATA_ROOT: code is
# rebuilt from git, logs are rotated by logrotate, and neither belongs on the
# corpus volume. Match what deploy/deploy.sh creates.
APP_ROOT=/opt/owllex
LOG_ROOT=/var/log/owllex

# ─── Embeddings (local, no API calls) ──────────────────────────────────────
# Accepts a short name (qwen3-embedding-8b / -4b / -0.6b) or any Hugging Face id.
# 8B needs ~16GB resident in bfloat16 -- on a smaller host use 4b or 0.6b.
# Qwen3-Embedding-0.6B is the production default: its native output is 1024
# dimensions (no truncation needed) and a query embedding costs ~80ms on CPU.
# The 8B model needs ~2.5s per query on the same hardware, which makes it an
# offline/GPU choice rather than a serving one. See rag/FAISS_ARCHITECTURE.md.
EMBED_MODEL=qwen3-embedding-0.6b
# Matryoshka truncation. This is what sets the index's RAM footprint: at 4096
# dims a 4M-chunk flat index needs ~64GB. Changing it invalidates every stored
# vector -- see rag/scripts/rebuild_index.py.
EMBED_DIM=1024
EMBED_BATCH_SIZE=8
# auto | cpu | cuda
EMBED_DEVICE=auto
EMBED_MAX_SEQ_LENGTH=1024

# ─── Vector index ──────────────────────────────────────────────────────────
# Flat is exact, needs no training, and is right below ~1M chunks.
# Past that, switch to the production factory and rebuild in bulk with
# rag/scripts/rebuild_index.py, which is what trains the quantizers:
#   OPQ64_1024,IVF8192,PQ64            up to ~5M chunks
#   OPQ64_1024,IVF32768_HNSW32,PQ64    up to ~50M chunks
#   OPQ64_1024,IVF131072_HNSW32,PQ64   up to ~500M chunks
# OPQ matters more than usual here: Matryoshka embeddings concentrate variance
# in the leading dimensions, so PQ without a rotation wastes most of its code
# budget. Sizing tables are in rag/FAISS_ARCHITECTURE.md.
FAISS_INDEX_FACTORY=Flat
# Writes the index to disk every N vector changes. 1 is safest. Raise it for a
# bulk import (the file is rewritten in full each flush), accepting that an
# unclean shutdown then needs a rebuild to reconcile with SQLite.
FAISS_FLUSH_EVERY=1

# ─── Metadata store ────────────────────────────────────────────────────────
SQLITE_BUSY_TIMEOUT_MS=15000
# LMDB pre-allocates this much address space (not disk). Must exceed the final
# index size; it cannot grow past it without a restart.
LMDB_MAP_SIZE_MB=4096

# ─── Ingestion ─────────────────────────────────────────────────────────────
# docling: layout + tables + OCR, real page numbers. pypdfium: text layer with
# OCR fallback -- much lighter, the right choice under ~4GB RAM.
PARSER_BACKEND=docling
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
# Recompress archived PDFs with Ghostscript. Lossy and irreversible; extraction
# always runs against the original, so retrieval quality is unaffected.
RAVENSLAW_PDF_COMPRESSION=true
RAVENSLAW_PDF_COMPRESSION_DPI=72

# ─── Backups ───────────────────────────────────────────────────────────────
# Nightly snapshot of FAISS + SQLite + LMDB + an incremental document mirror.
#
# BACKUP_ENABLED controls the *in-process* APScheduler job. On a systemd
# deployment set it to false and let owllex-backup.timer own the schedule --
# running both means two processes writing the same snapshot directory, and the
# timer still fires when the API is down, which is when you most want it to.
# deploy/deploy.sh sets this to false for you.
BACKUP_ENABLED=false
BACKUP_HOUR=3
BACKUP_MINUTE=30
# Snapshots kept, counted rather than aged: a box that was off for a week keeps
# its last good backups instead of expiring all of them on the way back up.
BACKUP_RETENTION_DAYS=14

# Mirror /data/documents into each snapshot. Cheap despite the size: unchanged
# PDFs are hard-linked against the previous snapshot (rsync --link-dest), so a
# night costs only the documents actually added that day. Turn off only if you
# mirror the archive off-host by another route (restic to a Storage Box).
BACKUP_DOCUMENTS=true
# Set false to force full copies instead of hard links. Almost never wanted --
# it multiplies disk use by BACKUP_RETENTION_DAYS.
BACKUP_DOCUMENTS_LINK_DEST=true
RSYNC_BINARY=rsync

# ─── PDF upload ────────────────────────────────────────────────────────────
# Transient staging for uploads in flight, deleted as soon as ingest finishes.
# Under DATA_ROOT rather than next to the code: these are whole PDFs, and a bulk
# import staged on the boot SSD is both the wrong disk and a way to fill it.
RAVENSLAW_UPLOAD_DIR=/data/tmp/uploads
RAVENSLAW_MAX_PDF_SIZE_MB=50

# ─── Security ──────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
RAVENSLAW_INTERNAL_TOKEN=
# Comma-separated. No wildcards, and HTTPS only, when RAVENSLAW_DEBUG=false.
RAVENSLAW_CORS_ORIGINS=
RAVENSLAW_TRUSTED_HOSTS=
RAVENSLAW_RATE_LIMIT_WINDOW_SECONDS=60
RAVENSLAW_RATE_LIMIT_MAX_REQUESTS=120

# ─── Clerk JWT ─────────────────────────────────────────────────────────────
CLERK_JWT_ISSUER=
# Optional -- only needed if audience verification is turned on in Clerk.
CLERK_JWT_AUDIENCE=

# ─── MongoDB (cause lists, catalogs) ───────────────────────────────────────
MONGODB_URI=
MONGODB_DB=cause_list_db

# ─── Scraper ───────────────────────────────────────────────────────────────
ENABLE_SCRAPER_SCHEDULER=false
PDF_DOWNLOAD_ENABLED=false
COURT_WEBSITE_URL=
# The scrapers' own "downloaded" index, separate from the ingest one.
SCRAPE_LMDB_PATH=/data/lmdb/scrapping_hashdb

# ─── Optional: public document origin ──────────────────────────────────────
# Only set if a read-only web server fronts /data/documents. Left empty, the
# app serves documents through its own token-checked viewer route instead.
PUBLIC_DOCS_BASE_URL=

# ─── Optional: metadata refinement through a hosted LLM ────────────────────
# Off by default: a stock deployment makes NO outbound API calls. Turning this
# on requires `uv sync --extra metadata-llm`. Court and citation are never
# model-generated either way -- a hallucinated citation is worse than none.
METADATA_LLM_ENABLED=false
METADATA_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ─── User documents ────────────────────────────────────────────────────────
# Per-upload size ceiling, enforced while the request body is being spooled to
# disk, so an oversized upload is cut off rather than buffered.
MAX_USER_DOCUMENT_MB=50
# Per-owner ceilings. The byte quota is measured against what is actually on the
# volume, not summed from the database, because the point of it is protecting
# the disk. Set USER_QUOTA_MB=0 to disable it.
MAX_USER_DOCUMENTS_PER_OWNER=2000
USER_QUOTA_MB=5120

# ─── Backup cadence ────────────────────────────────────────────────────────
# SQLite, LMDB and FAISS are snapshotted every night. The two document trees are
# mirrored weekly (they are immutable once written, so a nightly walk of millions
# of files would prove nothing changed), on this weekday: 0 = Monday, 6 = Sunday.
# The first run on an empty backup root always mirrors, whatever day it is.
BACKUP_WEEKLY_WEEKDAY=6
BACKUP_USERS=true
